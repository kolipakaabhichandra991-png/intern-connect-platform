generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id // Now maps directly to Supabase auth.users UUID
  email         String   @unique
  role          String   @default("INTERN")
  otpCode       String?
  otpExpiry     DateTime?
  
  xp            Int      @default(0) // Gamification points

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  internProfile InternProfile?
  givenReviews  Review[]       @relation("Reviewer")
  hrReviews     DailyReport[]  @relation("HrReviewer")

  sentKudos     Kudo[]         @relation("Sender")
  receivedKudos Kudo[]         @relation("Receiver")
}

model Kudo {
  id         String   @id @default(cuid())
  message    String
  createdAt  DateTime @default(now())

  senderId   String
  receiverId String
  
  sender     User     @relation("Sender", fields: [senderId], references: [id])
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String
  url         String
  category    String   @default("General")
  createdAt   DateTime @default(now())
}


model InternProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name              String
  dob               DateTime
  designation       String
  department        String   @default("Engineering")
  teamName          String   @default("Nexus WebGL Core")
  xp                Int      @default(0)
  photoUrl          String?
  idCardNumber      String   @unique

  age               Int?
  gender            String?
  height            Float?
  weight            Float?
  bloodGroup        String?
  city              String?

  bio               String?
  likesCorporate    String?
  dislikesCorporate String?

  instagramId       String?
  linkedInId        String?
  githubId          String?
  galleryImages     String   @default("[]") // JSON stringified array

  completedProjects String   @default("[]") // JSON stringified array
  ongoingProjects   String   @default("[]") // JSON stringified array

  upcomingProjectTitle String?
  upcomingProjectDesc  String?
  upcomingProjectDate  String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reviews           Review[]
  dailyReports      DailyReport[]
}

model Review {
  id          String     @id @default(cuid())
  type        String
  rating      Int
  comments    String?
  timestamp   DateTime   @default(now())

  reviewerId  String
  reviewer    User       @relation("Reviewer", fields: [reviewerId], references: [id])
  
  internId    String
  intern      InternProfile @relation(fields: [internId], references: [id], onDelete: Cascade)
}

model DailyReport {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  reportOfDay    String
  learningOfDay  String
  meetingOfDay   String

  hrReview       String?
  hrReviewerId   String?
  hrReviewer     User?    @relation("HrReviewer", fields: [hrReviewerId], references: [id])

  internId       String
  intern         InternProfile @relation(fields: [internId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


